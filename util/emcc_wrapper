#!/usr/bin/env python3

# A simple wrapper for emcc that changes the output file extension to .js

import argparse
import json
import os
import subprocess


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("-o", type=str, required=True)
    overwritten_args, extra_args = parser.parse_known_args()

    orig_output = overwritten_args.o
    root, ext = os.path.splitext(orig_output)
    assert ext in [".wasm", ".js"]
    output = root + ".js"

    if os.path.basename(root) == "cspuz_solver_backend":
        exports = {
            "_solve_problem", "_enumerate_answers_problem", "_malloc", "_free",
            "_numlin_cubes", "_numlin_solve_cube", "_numlin_split_cube", "_numlin_estimate_cube",
        }
        cleaned = []
        for value in extra_args:
            if value.startswith("EXPORTED_FUNCTIONS="):
                raw = value.split("=", 1)[1]
                exports.update(json.loads(raw) if raw.startswith("[") else raw.split(","))
                if cleaned and cleaned[-1] == "-s":
                    cleaned.pop()
            else:
                cleaned.append(value)
        extra_args = cleaned + ["-s", "EXPORTED_FUNCTIONS=" + ",".join(sorted(exports))]

    remove_arg = "-sSIDE_MODULE=2"
    if remove_arg in extra_args:
        extra_args.remove(remove_arg)

    args = ["emcc", "-o", output] + extra_args
    subprocess.check_call(args)


if __name__ == "__main__":
    main()
